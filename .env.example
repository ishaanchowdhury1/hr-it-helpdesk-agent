# Postgres connection used by the MCP server
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/helpdesk

# Which LLM to use: anthropic, openai, google or groq
LLM_PROVIDER=anthropic

# Fill in only the key for the provider you picked
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: override the default model names
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o-mini
GOOGLE_MODEL=gemini-3.5-flash

# Groq (free, fast)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
